+@register_adv_est(AdvantageEstimator.OPD)
+def compute_opd_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    old_log_probs: torch.Tensor,
+    ref_log_prob: torch.Tensor,
+    index: Optional[np.ndarray] = None,
+    reward_baselines: Optional[torch.Tensor] = None,
+    config: Optional[AlgoConfig] = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Compute minimal on-policy distillation advantages.
+
+    OPD uses the teacher/reference log probability minus the student rollout
+    log probability as a token-level advantage on the student's own rollout.
+    """
+    with torch.no_grad():
+        advantages = (ref_log_prob - old_log_probs) * response_mask
+
+    return advantages, advantages
+
+
+def _get_topd_alpha(config: Optional[AlgoConfig] = None) -> float:
+    alpha = 0.1
+    if config is not None:
+        if hasattr(config, "get"):
+            alpha = config.get("topd_alpha", alpha)
+        else:
+            alpha = getattr(config, "topd_alpha", alpha)
+    alpha = float(alpha)
+    if not 0.0 < alpha <= 1.0:
+        raise ValueError(f"TOP-D requires 0 < topd_alpha <= 1, got {alpha}.")
+    return alpha
+
+
+def _compute_topd_immediate_rewards(
+    old_log_probs: torch.Tensor,
+    ref_log_prob: torch.Tensor,
+    response_mask: torch.Tensor,
+    alpha: float,
+) -> torch.Tensor:
+    valid_mask = response_mask.bool()
+    log_ratio = torch.where(valid_mask, ref_log_prob - old_log_probs, torch.zeros_like(old_log_probs))
+    if alpha == 1.0:
+        return log_ratio * response_mask
+    topd_rewards = torch.logaddexp(
+        log_ratio + math.log(alpha),
+        torch.full_like(log_ratio, math.log1p(-alpha)),
+    )
+    return topd_rewards * response_mask
+
+
+def _compute_topd_token_returns(
+    topd_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+) -> torch.Tensor:
+    topd_rewards = topd_rewards * response_mask
+    future_sum = torch.flip(torch.cumsum(torch.flip(topd_rewards, dims=[-1]), dim=-1), dims=[-1]) - topd_rewards
+    response_lengths = response_mask.sum(dim=-1, keepdim=True)
+    positions = torch.arange(topd_rewards.shape[-1], device=topd_rewards.device, dtype=response_lengths.dtype).unsqueeze(0)
+    future_count = response_lengths - positions - 1
+    future_avg = torch.where(
+        future_count > 0,
+        future_sum / future_count.clamp_min(1),
+        torch.zeros_like(topd_rewards),
+    )
+    return (topd_rewards + future_avg) * response_mask
+
+
+def _normalize_topd_token_returns_by_prompt(
+    token_returns: torch.Tensor,
+    response_mask: torch.Tensor,
+    index: Optional[np.ndarray],
+    epsilon: float = 1e-6,
+) -> torch.Tensor:
+    advantages = torch.zeros_like(token_returns)
+    if index is None:
+        valid_values = token_returns[response_mask.bool()]
+        if valid_values.numel() == 0:
+            return advantages
+        mean = valid_values.mean()
+        std = valid_values.std(unbiased=False)
+        return ((token_returns - mean) / (std + epsilon)) * response_mask
+
+    id2indices = defaultdict(list)
+    for i, idx in enumerate(index):
+        id2indices[idx].append(i)
+
+    for indices in id2indices.values():
+        batch_indices = torch.tensor(indices, device=token_returns.device, dtype=torch.long)
+        group_returns = token_returns[batch_indices]
+        group_mask = response_mask[batch_indices]
+        valid_values = group_returns[group_mask.bool()]
+        if valid_values.numel() == 0:
+            continue
+        mean = valid_values.mean()
+        std = valid_values.std(unbiased=False)
+        advantages[batch_indices] = ((group_returns - mean) / (std + epsilon)) * group_mask
+
+    return advantages
+
+
+@register_adv_est(AdvantageEstimator.TOPD)
+def compute_topd_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    old_log_probs: torch.Tensor,
+    ref_log_prob: torch.Tensor,
+    index: Optional[np.ndarray] = None,
+    reward_baselines: Optional[torch.Tensor] = None,
+    config: Optional[AlgoConfig] = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Compute TOP-D advantages.
+
+    TOP-D replaces the OPD reward with log(alpha * exp(ref_log_prob - old_log_probs) + 1 - alpha),
+    then computes token-level future returns and prompt-group token-level normalized advantages.
+    """
+    del token_level_rewards, reward_baselines
+    with torch.no_grad():
+        alpha = _get_topd_alpha(config)
+        topd_rewards = _compute_topd_immediate_rewards(
+            old_log_probs=old_log_probs,
+            ref_log_prob=ref_log_prob,
+            response_mask=response_mask,
+            alpha=alpha,
+        )
+        token_returns = _compute_topd_token_returns(topd_rewards, response_mask)
+        advantages = _normalize_topd_token_returns_by_prompt(token_returns, response_mask, index=index)
+
+    return advantages, token_returns
+
+
+@register_adv_est(AdvantageEstimator.NAIVE_TOPD)
+def compute_naive_topd_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    old_log_probs: torch.Tensor,
+    ref_log_prob: torch.Tensor,
+    index: Optional[np.ndarray] = None,
+    reward_baselines: Optional[torch.Tensor] = None,
+    config: Optional[AlgoConfig] = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Compute a naive TOP-D variant that only replaces OPD's immediate reward."""
+    del token_level_rewards, index, reward_baselines
+    with torch.no_grad():
+        alpha = _get_topd_alpha(config)
+        advantages = _compute_topd_immediate_rewards(
+            old_log_probs=old_log_probs,
+            ref_log_prob=ref_log_prob,
+            response_mask=response_mask,
+            alpha=alpha,
+        )
+
+    return advantages, advantages
+
