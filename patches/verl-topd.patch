+def compute_distillation_avg_metrics(data_sources, sample_uids, infos_dict, expected_n):
+    """TOP-D release metric: mean correctness across N samples, then prompts.
+
+    This is avg@N, not best-of-N or pass@N. Never label an incomplete group as N.
+    Scores remain fractions in [0, 1]; multiply by 100 only for percentage display.
+    """
+    if expected_n < 1:
+        raise ValueError("Validation sample count must be positive.")
+    if "acc" not in infos_dict:
+        raise ValueError("Distillation validation requires the verifier's 'acc' field.")
+    scores = infos_dict["acc"]
+    if not len(scores) == len(data_sources) == len(sample_uids):
+        raise ValueError("Validation sources, prompt IDs and accuracy arrays must align.")
+    grouped = defaultdict(list)
+    for source, uid, score in zip(data_sources, sample_uids, scores, strict=True):
+        score = float(score)
+        if not np.isfinite(score) or not 0.0 <= score <= 1.0:
+            raise ValueError("Accuracy must be a finite fraction in [0, 1].")
+        grouped[(str(source), str(uid))].append(score)
+    per_source = defaultdict(list)
+    for (source, uid), values in grouped.items():
+        if len(values) != expected_n:
+            raise ValueError(f"Expected {expected_n} samples for {source}/{uid}, got {len(values)}.")
+        per_source[source].append(float(np.mean(values)))
+    metrics = {}
+    for source, values in per_source.items():
+        mean = float(np.mean(values))
+        metrics[f"val/acc/{source}/avg@{expected_n}"] = mean
+        metrics[f"val-core/{source}/acc/avg@{expected_n}"] = mean
+    return metrics
+
